# Copy to .env and fill in as each key becomes available.
# Nothing here is required to run in mock mode tonight.

# --- pipeline mode -----------------------------------------------------
# mock  -> canned realistic scores, zero external calls (default, works offline tonight)
# local -> real ESM2 inference on CPU via fair-esm, no sponsor access needed
# proto -> real Proto MCP calls (needs PROTO_* below, available at check-in)
WILDTYPE_MODE=mock

# --- Claude (agent brain) ----------------------------------------------
ANTHROPIC_API_KEY=

# --- Proto (ESMFold, AlphaFold3, Evo1, ProteinMPNN, TM-align, UniProt) --
# No API key / base URL — proto_tools runs in-process (pip install from
# git, see requirements.txt), not a hosted REST API. UniProt fetch works
# CPU-only, no auth needed (confirmed live). Everything GPU-heavy (ESM2/3
# scoring, ESMFold, AlphaFold3, Evo1) needs EITHER a local GPU OR Modal
# credentials — run `modal setup` in your terminal (account-tied, can't be
# done for you) to auth Modal; nothing to fill in below for Proto itself.

# --- Biohub (ESM2/ESM3/ESMC/ESMFold2 — alternative path to Proto's models) --
# Free account required: https://biohub.ai/developer-console/api-keys
# Not yet wired into any client — same models Proto already serves for
# free via Modal, this is a redundant path, not a new capability.
BIOHUB_API_KEY=

# --- Paperclip (literature search) --------------------------------------
# Setup is NOT `pip install` — it's a machine-level installer + login:
#   curl -fsSL https://paperclip.gxl.ai/install.sh | bash
#   paperclip login
# Leave PAPERCLIP_API_KEY blank (or omit the line) to use the cached login
# from `paperclip login` (fine for one person's laptop); set it if the demo
# machine needs to work without depending on whoever's account is logged in.
# IMPORTANT: leave PAPERCLIP_BASE_URL commented out, don't set it to blank —
# `PAPERCLIP_BASE_URL=` (present but empty) broke real search calls live
# (2026-08-15): python-dotenv sets it as an actual empty-string env var, and
# the SDK's fallback treats "present but empty" differently from "unset",
# so it tried to build a URL from '' instead of its real default and every
# search failed with AuthError: "Could not refresh ID token". Uncomment
# only if you have a real override value.
PAPERCLIP_API_KEY=
# PAPERCLIP_BASE_URL=

# --- BenchFlow — dropped 2026-08-15 -------------------------------------
# github.com/benchflow-ai is the correct org (agent-benchmarking infra) —
# just out of scope for this pipeline, not integrating. No key required.

# --- Benchling (structured storage) ---------------------------------------
# Same blank-vs-unset trap as PAPERCLIP_BASE_URL above — leave commented
# out until a Tenant Admin actually hands you real values, don't set blank.
# BENCHLING_API_KEY=
# BENCHLING_TENANT=

