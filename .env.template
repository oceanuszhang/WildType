# Copy to .env and fill in as each key becomes available.
# Nothing here is required to run in mock mode tonight.

# --- pipeline mode -----------------------------------------------------
# mock  -> canned realistic scores, zero external calls (default, works offline tonight)
# local -> real ESM2 inference on CPU via fair-esm, no sponsor access needed
# proto -> real Proto MCP calls (needs PROTO_* below, available at check-in)
WILDTYPE_MODE=mock

# --- Claude (agent brain) ----------------------------------------------
ANTHROPIC_API_KEY=

# --- Proto (ESMFold, AlphaFold3, Evo1, ProteinMPNN, TM-align, UniProt) --
PROTO_API_KEY=
PROTO_BASE_URL=

# --- Paperclip (literature search) --------------------------------------
PAPERCLIP_API_KEY=
PAPERCLIP_BASE_URL=

# --- BenchFlow (workflow tracking) ---------------------------------------
BENCHFLOW_API_KEY=

# --- Benchling (structured storage) ---------------------------------------
BENCHLING_API_KEY=
BENCHLING_TENANT=

# --- demo data paths (relative to repo root, already checked in under data/) ---
WILDTYPE_EMBARK_CSV=data/ollie_embark/Embark-full-results-data-31211050316783.csv
WILDTYPE_TPED=data/ollie_embark/raw/31211050316783.tped
WILDTYPE_TFAM=data/ollie_embark/raw/31211050316783.tfam
